# Optional provider keys. Leave blank unless you intend to run provider-backed
# actions. Benchmark, judge, embedding, query-rewrite, ATaR extraction, and
# intercept-analysis flows can spend API credits when keys are configured.
#
# OPENAI_API_KEY: leave OPENAI_BASE_URL unset below to use a standard OpenAI
# key against the standard host. Deployed environments (dev/staging/prod) use
# a UK data-residency key against OPENAI_BASE_URL=https://gb.api.openai.com/v1
# instead - only set that here if your own key is also UK-region-scoped,
# since the GB host rejects keys that aren't.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://gb.api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=

# Local tariff database. Override before using DB-backed search, KG, eval, rate,
# and classification workflow flows.
TARIFF_DB_DSN=postgresql:///tariff_db
TARIFF_DB_SCHEMA=uk
TARIFF_DB_KG_SCHEMA=kg

# Local serving defaults used by start.sh.
AI_FAN_OUT_HOST=127.0.0.1
AI_FAN_OUT_PORT=8000
CLASSIFY_EVAL_MAX_EST_USD=10.00
