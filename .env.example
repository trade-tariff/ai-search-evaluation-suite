# Worker configuration. Leave provider keys blank unless the run needs them.
#
# OPENAI_API_KEY is required when CLASSIFICATION_ALLOW_PROVIDER_CALLS is enabled
# and a run uses the trader simulator. Deployed environments use a UK
# data-residency key with OPENAI_BASE_URL=https://gb.api.openai.com/v1. Only set
# that host here if your key is UK-region-scoped.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://gb.api.openai.com/v1

# Worker simulator provider-call gate. Backend search spend is separate.
CLASSIFICATION_ALLOW_PROVIDER_CALLS=

# Trade Tariff Backend that starts runs and stores results.
# Leave unset to use the client default of http://127.0.0.1:3000.
# TRADE_TARIFF_BACKEND_BASE_URL=

# Optional worker authentication. Set one method per deployment.
AI_FAN_OUT_BEARER_TOKEN=
AI_FAN_OUT_BASIC_AUTH_USER=
AI_FAN_OUT_BASIC_AUTH_PASSWORD=
AI_FAN_OUT_AUTH_PUBLIC_PATHS=/api/health

# Local start.sh defaults.
CLASSIFY_EVAL_HOST=127.0.0.1
CLASSIFY_EVAL_PORT=8100

# Optional simulator model override. Leave unset to use gpt-5-mini.
# QA_SIMULATOR_MODEL=
